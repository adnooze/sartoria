---
import { img } from "../data/site";
---

<section class="section mosaic" id="kolekcija">
  <a class="tile tile--tall" href="#lookbook" data-filter="aurora">
    <img src={img("DU_te4uiEGG_03", 1400)} alt="Detalj haljine Aurora s ružom" loading="lazy" />
    <div class="tile__text">
      <h3>Aurora</h3>
      <p>Duga, lepršava haljina od svilenkasto lagane tkanine — izbor za maturu i svečane prilike.</p>
      <span class="link-arrow">Pogledaj</span>
    </div>
  </a>
  <a class="tile" href="#lookbook" data-filter="jesen">
    <img src={img("Db4_bv5CEQe_03", 1400)} alt="Haljina u boji senfa" loading="lazy" />
    <div class="tile__text">
      <h3>Jesen je stigla</h3>
      <p>Posebni krojevi i pažljivo birani materijali.</p>
      <span class="link-arrow">Pogledaj</span>
    </div>
  </a>
  <a class="tile" href="#lookbook" data-filter="karirano">
    <img src={img("Ddj91wQCFgj_01", 1400)} alt="Karirana haljina" loading="lazy" />
    <div class="tile__text">
      <h3>Karirano &amp; pruge</h3>
      <p>Klasični uzorci za svaki dan.</p>
      <span class="link-arrow">Pogledaj</span>
    </div>
  </a>
  <a class="tile tile--wide" href="#novo" data-tab="akcija">
    <div class="tile__panel">
      <p class="eyebrow">Posljednji komadi</p>
      <h3>Sniženje<br /><em>od 20 KM</em></h3>
      <p>Omiljeni modeli po posebnim cijenama — akcija traje do isteka zaliha.</p>
      <span class="btn btn--light">Do akcije</span>
    </div>
    <img src={img("DezoFhxiDeA_08", 1400)} alt="Crna haljina s kaišem" loading="lazy" />
  </a>
</section>

<section class="quote">
  <p class="eyebrow">Sartoria</p>
  <blockquote>„Nositi nešto što niko drugi nema? Neprocjenjivo.”</blockquote>
</section>
