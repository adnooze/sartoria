---
import { NAV, IG, FB, DM } from "../data/site";
---

<div class="announce">
  <p>Šivanje po mjeri i želji <span>·</span> Dostava poštom širom BiH <span>·</span> Cijene već od 39 KM</p>
</div>

<header class="header" id="top">
  <nav class="nav nav--left" aria-label="Glavna navigacija">
    {NAV.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  <a href="#top" class="logo" aria-label="Sartoria — početna">SARTORIA</a>
  <div class="nav nav--right">
    <a href={IG} target="_blank" rel="noopener" aria-label="Instagram">
      <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4.2"></circle><circle cx="17.4" cy="6.6" r=".6" fill="currentColor"></circle></svg>
    </a>
    <a href={FB} target="_blank" rel="noopener" aria-label="Facebook">
      <svg viewBox="0 0 24 24"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"></path></svg>
    </a>
    <a href={DM} target="_blank" rel="noopener" class="nav__cta">Naruči</a>
    <button class="burger" aria-label="Otvori meni" aria-expanded="false"><span></span><span></span></button>
  </div>
</header>

<div class="drawer" id="drawer">
  {NAV.map((l) => <a href={l.href}>{l.label}</a>)}
  <a href={DM} target="_blank" rel="noopener">Naruči u inbox</a>
</div>
