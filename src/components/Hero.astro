---
import { img } from "../data/site";
---

<section class="hero">
  <div class="hero__media">
    <img src={img("DU_te4uiEGG_06", 1400)} alt="Haljina Aurora u lila nijansi s ružom" fetchpriority="high" />
    <img src={img("DU_te4uiEGG_02", 1400)} alt="Haljina Aurora s raskošnim rukavima" />
    <img src={img("DU_te4uiEGG_10", 1400)} alt="Lepršava svečana haljina Aurora" />
  </div>
  <div class="hero__content">
    <p class="eyebrow">Jesenja kolekcija 2026</p>
    <h1>Elegancija.<br />Po mjeri.<br />Vaša.</h1>
    <p class="hero__lead">
      Haljine šivane s posebnom pažnjom — pažljivo birani materijali, univerzalne veličine i dužina po vašoj želji.
    </p>
    <div class="hero__actions">
      <a href="#novo" class="btn btn--light">Pogledaj kolekciju</a>
      <a href="#po-mjeri" class="link-arrow">Šivanje po mjeri</a>
    </div>
  </div>
</section>
